{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ararahq/pluma/schema/brand.schema.json",
  "title": "pluma brand",
  "description": "Visual identity for Pluma documents. Every property is optional.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": { "type": "string", "description": "Body font family" },
        "heading": { "type": "string", "description": "Heading font family (defaults to the body family)" },
        "mono": { "type": "string", "description": "Code font family" },
        "size": { "type": "number", "minimum": 6, "maximum": 18, "description": "Base font size in points" }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/hex" },
        "muted": { "$ref": "#/$defs/hex" },
        "faint": { "$ref": "#/$defs/hex" },
        "accent": { "$ref": "#/$defs/hex", "description": "Title accent rule" },
        "link": { "$ref": "#/$defs/hex" },
        "border": { "$ref": "#/$defs/hex" },
        "codeBackground": { "$ref": "#/$defs/hex" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paper": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "a4, us-letter, a5..." },
        "marginX": { "$ref": "#/$defs/length" },
        "marginY": { "$ref": "#/$defs/length" }
      }
    },
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "description": "Path relative to brand.json" },
        "width": { "$ref": "#/$defs/length" }
      }
    },
    "footer": { "type": "string", "description": "Footer text; page numbering is automatic" }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
    "length": { "type": "string", "pattern": "^[0-9.]+(pt|mm|cm|in|em)$" }
  }
}
