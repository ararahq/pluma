{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ararahq/pluma/schema/context-manifest-v2.json",
  "title": "Pluma context manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "name", "createdAt", "source", "relations", "artifacts", "warnings", "compiler", "fingerprint"],
  "properties": {
    "format": { "const": "pluma-context" },
    "version": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
    "name": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/source" },
    "relations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relation" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "compiler": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "const": "@ararahq/pluma" }, "version": { "type": "string", "minLength": 1 } }
    },
    "fingerprint": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["kind", "name", "sha256", "bytes"],
      "properties": { "kind": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/hash" }, "bytes": { "type": "integer", "minimum": 0 } }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"],
      "properties": { "path": { "type": "string", "pattern": "^(blocks|views|indexes|provenance)/" }, "sha256": { "$ref": "#/$defs/hash" }, "bytes": { "type": "integer", "minimum": 0 } }
    },
    "field": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "type", "nullable"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "name": { "type": "string" },
        "type": { "enum": ["null", "boolean", "int64", "float64", "decimal", "utf8", "binary", "date", "timestamp", "json"] },
        "nullable": { "type": "boolean" }, "precision": { "type": "integer", "minimum": 1 }, "scale": { "type": "integer", "minimum": 0 }, "timezone": { "type": "string" }
      }
    },
    "statistics": {
      "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["nullCount"], "properties": { "nullCount": { "type": "integer", "minimum": 0 }, "min": {}, "max": {} } }
    },
    "block": {
      "type": "object", "additionalProperties": false, "required": ["hash", "path", "relationId", "rowStart", "rowEnd", "bytes"],
      "properties": { "hash": { "$ref": "#/$defs/hash" }, "path": { "type": "string", "pattern": "^blocks/[a-f0-9]{64}\\.arrow$" }, "relationId": { "type": "string" }, "rowStart": { "type": "integer", "minimum": 0 }, "rowEnd": { "type": "integer", "minimum": 0 }, "bytes": { "type": "integer", "minimum": 1 }, "statistics": { "$ref": "#/$defs/statistics" } }
    },
    "index": {
      "type": "object", "additionalProperties": false, "required": ["id", "columns", "path", "entries", "sha256", "bytes", "comparison", "nulls"],
      "properties": { "id": { "type": "string" }, "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "path": { "type": "string", "pattern": "^indexes/" }, "entries": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/hash" }, "bytes": { "type": "integer", "minimum": 1 }, "comparison": { "const": "canonical-v1" }, "nulls": { "const": "first" } }
    },
    "metric": { "type": "object", "additionalProperties": false, "required": ["aggregate", "as"], "properties": { "column": { "type": "string" }, "aggregate": { "enum": ["count", "sum", "min", "max", "avg"] }, "as": { "type": "string" } } },
    "aggregate": {
      "type": "object", "additionalProperties": false, "required": ["id", "groupBy", "metrics", "path", "offsetsPath", "groups", "sha256", "bytes", "offsetsSha256", "offsetsBytes"],
      "properties": { "id": { "type": "string" }, "groupBy": { "type": "array", "items": { "type": "string" } }, "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } }, "path": { "type": "string", "pattern": "^indexes/" }, "offsetsPath": { "type": "string", "pattern": "^indexes/" }, "groups": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/hash" }, "bytes": { "type": "integer", "minimum": 0 }, "offsetsSha256": { "$ref": "#/$defs/hash" }, "offsetsBytes": { "type": "integer", "minimum": 0 } }
    },
    "relation": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "fields", "rowCount", "blocks"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }, "rowCount": { "type": "integer", "minimum": 0 }, "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }, "indexes": { "type": "array", "items": { "$ref": "#/$defs/index" } }, "materializedAggregates": { "type": "array", "items": { "$ref": "#/$defs/aggregate" } } }
    }
  }
}
