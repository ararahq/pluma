{
  "name": "@pluma/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c red,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "PLUMA_UNSAFE_DEV_WORKER=true tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server && npm run build:scripts",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server/index.js --packages=external && esbuild src/server/worker/entry.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server/worker/entry.js --external:@myriaddreamin/typst-ts-node-compiler",
    "build:scripts": "esbuild scripts/migrate.ts scripts/reconcile-stripe.ts scripts/smoke-data-plane.ts scripts/validate-stripe-catalog.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist/server/scripts --packages=external",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "migrate:prod": "node --env-file-if-exists=.env dist/server/scripts/migrate.js",
    "reconcile:stripe": "tsx --env-file-if-exists=.env scripts/reconcile-stripe.ts",
    "reconcile:stripe:prod": "node --env-file-if-exists=.env dist/server/scripts/reconcile-stripe.js",
    "smoke:data-plane:prod": "node dist/server/scripts/smoke-data-plane.js",
    "validate:stripe": "tsx --env-file-if-exists=.env scripts/validate-stripe-catalog.ts",
    "validate:stripe:prod": "node --env-file-if-exists=.env dist/server/scripts/validate-stripe-catalog.js"
  },
  "dependencies": {
    "@ararahq/pluma": "file:../..",
    "@gsap/react": "^2.1.2",
    "@hono/node-server": "2.1.1",
    "better-auth": "1.7.1",
    "gsap": "^3.15.0",
    "hono": "4.13.3",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
