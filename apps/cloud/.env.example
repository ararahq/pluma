# Application
NODE_ENV=development
PORT=8787
PLUMA_PUBLIC_ORIGIN=http://localhost:5173
PLUMA_TRUSTED_PROXY_HOPS=0
PLUMA_WORKER_CONCURRENCY=2
PLUMA_QUEUE_TIMEOUT_MS=60000
# Local macOS/non-Linux development only. Production refuses to start with this.
PLUMA_UNSAFE_DEV_WORKER=true
# Serve the prebuilt web client from the API process (used by Docker Compose).
PLUMA_SERVE_CLIENT=false

# Standard PostgreSQL. Docker Compose uses the same default credentials locally.
DATABASE_URL=postgresql://pluma:pluma@localhost:5432/pluma
PLUMA_DATABASE_POOL_SIZE=10
# Production defaults to verify-full using the system public CA bundle.
# For a private database CA, provide the base64-encoded PEM certificate.
# Development defaults to disable. Production defaults to verify-full; explicit
# disable is only for an isolated loopback/sidecar database and emits a warning.
PLUMA_DATABASE_TLS_MODE=
PLUMA_DATABASE_TLS_CA_BASE64=

# Generate both with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
# A high-entropy server secret used to hash API keys.
PLUMA_API_KEY_PEPPER=replace-with-a-different-high-entropy-secret
# Comma-separated base64 32-byte AES keys, newest first, for 15-minute replay envelopes.
PLUMA_IDEMPOTENCY_KEYS=replace-with-base64-32-byte-key

# HTTPS transactional-email adapter. It receives
# { to, purpose: "verify" | "reset", action_url }. Required in production.
PLUMA_EMAIL_DELIVERY_URL=
PLUMA_EMAIL_DELIVERY_TOKEN=

# Optional GitHub social sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe test keys and canonical monthly price IDs. Required to enable billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DEVELOPER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
