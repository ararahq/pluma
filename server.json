{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ararahq/pluma",
  "title": "Pluma",
  "description": "Read text-layer PDFs, HTML, and public URLs into Markdown, then render Markdown as production-ready PDF.",
  "repository": {
    "url": "https://github.com/ararahq/pluma",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@ararahq/pluma",
      "version": "0.2.0",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
